PROJECT_NAME=HealthGuardian
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/healthguardian_db
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_32CHARS_MIN
BACKEND_CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1

# Optional external APIs
OPENWEATHER_API_KEY=
NEWSDATA_API_KEY=


# Password reset / OTP email (Brevo recommended; SMTP is also supported)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HealthGuardian
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@healthguardian.app
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Optional Have I Been Pwned account security check
# Authenticated breach-by-account lookups require a HIBP API key and User-Agent.
HIBP_API_KEY=
HIBP_USER_AGENT=HealthGuardian-Security-Checker/1.0

# Doctor registration verification code (change in production)
DOCTOR_REGISTRATION_CODE=DOCT2026

